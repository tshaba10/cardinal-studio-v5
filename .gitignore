# Secrets stay on each computer. Only the blank setup template is shared.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Local Python environments and caches are recreated after cloning.
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store

# Generated datasets, uploaded data, session notes and reports.
.runs/
cardinal_session*.json
cardinal_quality_report*.json
cardinal_dataset_review*.json
cardinal_contract*.json
cardinal_graph*.svg
uploads/
exports/
output*/
*.log

# Local backups, editor state and packaged copies are not application source.
.change-backups/
backups/
backup/
archive/
archives/
obsolete/
.vscode/
.idea/
.history/
*.bak
*.backup
*_backup.*
*_old.*
*.orig
*.tmp
*.swp
*.swo
*~
/*.zip
/*.tar.gz

# Regenerated by export_graphs.py or the Diagrams & session notes page.
/interview_graph.svg
/design_graph.svg
/quality_graph.svg
/langgraph_diagrams.md

# Private credentials, local databases and accidental data exports.
*.pem
*.key
*.p12
*.pfx
*.sqlite*
*.db
/*.csv
/*.xlsx
/*.xls
/*.parquet
/*.pdf
